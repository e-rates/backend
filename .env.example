# Copy to .env and fill in. SECRET_KEY also keys the integrity hashes; rotating it needs a rehash.
DEBUG=True
SECRET_KEY='generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"'
FIELD_ENCRYPTION_KEY='generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"'
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_NAME=e-rates
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Assistant model (Qwen on Colab for now): base URL of the notebook's public tunnel.
# If LLM_API_URL ends in /v1 the server speaks OpenAI chat-completions (Ollama, vLLM, llama.cpp).
# Otherwise it POSTs {"text": prompt} to $LLM_API_URL/analyze and reads response/answer/text from the JSON reply.
LLM_API_URL=
COUNTY_NAME=Nairobi City County
# Daraja: sandbox shortcode 174379; its passkey is on the Daraja portal test credentials page
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till only: MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline, MPESA_SHORTCODE=<store/HO number>, MPESA_PARTY_B=<till number>
MPESA_PARTY_B=
# Public base, e.g. https://<id>.ngrok-free.app/api/payments/stk-callback ; add the host to ALLOWED_HOSTS
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET='generate: python -c "import secrets; print(secrets.token_urlsafe(24))"'

# Model name served by LLM_API_URL when it is an OpenAI-compatible /v1 endpoint.
LLM_MODEL=qwen2.5
